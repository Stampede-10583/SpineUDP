<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spine_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters for the Spine coprocessor: bench (companion + synthetic pose + stats) and Orin production (companion + stats).</description>
  <maintainer email="jameskorten4@gmail.com">FRC Team 10583</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>spine_link</exec_depend>
  <exec_depend>spine_stats</exec_depend>

  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>spine_interfaces</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
