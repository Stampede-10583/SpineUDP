<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spine_link</name>
  <version>0.1.0</version>
  <description>Coprocessor end of the Spine RIO-Orin UDP link: wire format, Stream 3 trigger table, Stream 2 order gate, and the companion and synthetic pose nodes.</description>
  <maintainer email="jameskorten4@gmail.com">FRC Team 10583</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>diagnostic_msgs</depend>
  <depend>spine_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
